#!/usr/bin/env bash
set -euo pipefail

sudo pacman -S --noconfirm --needed base-devel git less wget openssh unzip pciutils ly \
  pipewire pipewire-alsa pipewire-jack pipewire-pulse wireplumber \
  networkmanager reflector iw iwd upower bluez bluez-utils \
  cups cups-pk-helper system-config-printer \
  docker docker-compose docker-buildx postgresql

GPU=$(lspci | grep -Ei "VGA|3D")

if echo "$GPU" | grep -qi "intel"; then
  sudo pacman -S --noconfirm --needed mesa vulkan-intel intel-media-driver
fi

if echo "$GPU" | grep -qi "amd\|ati"; then
  sudo pacman -S --noconfirm --needed mesa vulkan-radeon xf86-video-amdgpu
fi

if echo "$GPU" | grep -qi "nvidia"; then
  sudo pacman -S --noconfirm --needed mesa vulkan-nouveau xf86-video-nouveau
fi

if ! command -v yay >/dev/null 2>&1; then
  mkdir -p "$HOME/Downloads"
  rm -rf "$HOME/Downloads/yay-bin"
  git clone https://aur.archlinux.org/yay-bin.git "$HOME/Downloads/yay-bin"
  (
    cd "$HOME/Downloads/yay-bin"
    makepkg -si --noconfirm
  )
fi

if [ ! -d "/var/lib/postgres/data" ]; then
  sudo -u postgres initdb --locale en_CA.UTF-8 -D /var/lib/postgres/data
fi

sudo systemctl enable --now NetworkManager bluetooth cups postgresql docker systemd-resolved.service ly@tty1
sudo usermod -aG docker "$USER"
sudo usermod -aG lp "$USER"
loginctl enable-linger "$USER"

sudo cp /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist.bak
sudo reflector \
  --country CA,US \
  --latest 20 \
  --protocol https \
  --sort rate \
  --age 12 \
  --save /etc/pacman.d/mirrorlist
