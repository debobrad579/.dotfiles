#!/usr/bin/env bash

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/tmux-sessionizer.conf"

if [[ -f "$CONFIG_FILE" ]]; then
    source "$CONFIG_FILE"
fi

[[ -n "$TS_SEARCH_PATHS" ]] || TS_SEARCH_PATHS=(~/personal ~/work)

if [[ ${#TS_EXTRA_SEARCH_PATHS[@]} -gt 0 ]]; then
    TS_SEARCH_PATHS+=("${TS_EXTRA_SEARCH_PATHS[@]}")
fi

find_dirs() {
    if [[ -n "${TMUX}" ]]; then
        current_session=$(tmux display-message -p '#S')
        tmux list-sessions -F "[TMUX] #{session_name}" 2>/dev/null | grep -vFx "[TMUX] $current_session"
    else
        tmux list-sessions -F "[TMUX] #{session_name}" 2>/dev/null
    fi

    for entry in "${TS_SEARCH_PATHS[@]}"; do
        if [[ "$entry" =~ ^([^:]+):([0-9]+)$ ]]; then
            path="${BASH_REMATCH[1]}"
            depth="${BASH_REMATCH[2]}"
        else
            path="$entry"
            depth="${TS_MAX_DEPTH:-1}"
        fi

    if [[ -d "$path" ]]; then
        if [[ "$depth" -eq 0 ]]; then
            echo "$path"
        else
            find "$path" -mindepth 1 -maxdepth "$depth" \
                -path '*/.git' -prune -o -type d -print
        fi
    fi

    done
}

selected="${1:-$(find_dirs | fzf)}"
[[ -z "$selected" ]] && exit 0

if [[ "$selected" =~ ^\[TMUX\]\ (.+)$ ]]; then
    selected="${BASH_REMATCH[1]}"
fi

selected_name=$(basename "$selected")
selected_name="${selected_name#.}"

tmux_running=$(pgrep tmux)
if [[ -z $TMUX && -z $tmux_running ]]; then
    tmux new-session -ds "$selected_name" -c "$selected"
fi

if ! tmux list-sessions | grep -q "^$selected_name:"; then
    tmux new-session -ds "$selected_name" -c "$selected"

    if [[ -f "$selected/.tmux-sessionizer" ]]; then
        tmux send-keys -t "$selected_name" "source $selected/.tmux-sessionizer" c-M
    elif [[ -f "$HOME/.tmux-sessionizer" ]]; then
        tmux send-keys -t "$selected_name" "source $HOME/.tmux-sessionizer" c-M
    fi
fi

if [[ -z $TMUX ]]; then
    tmux attach-session -t "$selected_name"
else
    tmux switch-client -t "$selected_name"
fi
