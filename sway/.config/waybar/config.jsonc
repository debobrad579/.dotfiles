{
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 0,
    "spacing": 1,
    "modules-left": [
        "sway/workspaces"
    ],
    "modules-center": [
        "custom/spotify"
    ],
    "modules-right": [
        "bluetooth",
        "network",
        "backlight",
        "battery",
        "pulseaudio",
        "clock",
        "custom/power"
    ],
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "<span size='130%'>{icon}</span>",
        "format-icons": {
            "1": "",
            "2": "",
            "3": ""
        }
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃝",
            "󰃠"
        ]
    },
    "pulseaudio": {
        "tooltip": false,
        "format": "{icon} {volume}%",
        "format-muted": "󰸈 ({volume}%)",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },
    "network": {
        "interval": 5,
        "tooltip": false,
        "format": "",
        "format-wifi": "{icon} {essid}",
        "format-ethernet": "󰈁 {ifname}",
        "format-icons": {
            "wifi": [
                "󰤯",
                "󰤟",
                "󰤢",
                "󰤥",
                "󰤨"
            ]
        }
    },
    "bluetooth": {
        "format": "",
        "format-connected": "󰂯 {device_alias}"
    },
    "battery": {
        "bat": "BAT1",
        "tooltip": false,
        "adapter": "ACAD",
        "interval": 30,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "{icon} {capacity}%",
        "format-icons": {
            "default": [
                "󰁹"
            ],
            "charging": [
                "󰂄"
            ],
            "discharging": [
                "󰂎",
                "󰁺",
                "󰁻",
                "󰁼",
                "󰁽",
                "󰁾",
                "󰁿",
                "󰂀",
                "󰂁",
                "󰂂"
            ]
        }
    },
    "clock": {
        "interval": 1,
        "format": "{:%H:%M}",
        "tooltip-format": "{:%Y-%m-%d %H:%M:%S}"
    },
    "custom/spotify": {
        "exec": "waybar-spotify",
        "tooltip": false,
        "escape": true,
        "on-click": "playerctl -p spotify play-pause",
        "on-scroll-up": "playerctl -p spotify volume 0.05+",
        "on-scroll-down": "playerctl -p spotify volume 0.05-"
    },
    "custom/power": {
        "format": "<span size='130%'>⏻</span>",
        "on-click": "wofi-powermenu"
    }
}
