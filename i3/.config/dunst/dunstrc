[global]
    monitor = 0
    follow = mouse
    width = (0, 450)
    height = (0, 300)
    origin = top-right
    offset = (48, 48)
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 10
    horizontal_padding = 15
    text_icon_padding = 10
    frame_width = 2
    frame_color = "#61AFEF"
    separator_color = frame
    sort = yes
    idle_threshold = 120

    font = monospace
    line_height = 4
    markup = full
    format = <b>%s</b>\n%b
    alignment = left
    vertical_alignment = top
    show_age_threshold = 60
    ellipsize = end
    ignore_newline = no
    show_indicators = yes

    icon_position = left
    min_icon_size = 64
    max_icon_size = 128
    
    sticky_history = yes
    history_length = 20

    dmenu = /usr/bin/rofi -dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    mouse_left_click = close_current
    mouse_middle_click = none
    mouse_right_click = close_all

[urgency_low]
    background = "#21252B"
    foreground = "#ABB2BF"
    frame_color = "#4B5263"
    timeout = 5

[urgency_normal]
    background = "#21252B"
    foreground = "#ABB2BF"
    frame_color = "#61AFEF"
    timeout = 10

[urgency_critical]
    background = "#21252B"
    foreground = "#E06C75"
    frame_color = "#E06C75"
    timeout = 0
